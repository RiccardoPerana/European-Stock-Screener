{
  "_comment": "Source of truth for the model parameters at Inputs!B48:B60. Same discipline as refdata_tables.json: version-controlled, hand-updated on a stated cadence, read by the pipeline, never silently rewritten. Every value carries its source and the date it was taken.",
  "_why_not_a_vendor": "These parameters are NOT sourced from the financial data provider, deliberately. The workbook is calibrated to Damodaran's definitions throughout: RefData carries his ratings-and-spread ladder, B58 his sales-to-capital ratio, B57 his unlevered beta. Mixing a vendor's beta with his spreads produces a WACC that belongs to neither system. Inputs!G57 says as much in the workbook itself.",
  "_cadence": {
    "B48": "quarterly - ECB, fetched automatically",
    "B49": "January and July - Damodaran refreshes country risk semiannually",
    "B50": "quarterly - review against ECB long-run projections",
    "B53": "January and July - same file as B49",
    "B54": "annually, plus on any announced rate change",
    "B57_B60": "annually each January, when Damodaran republishes"
  },
  "_units": "ALL RATES ARE FRACTIONS. 0.026 is 2.6%. Writing 2.6 into B48 produces a 260% risk-free rate -- the likeliest silent corruption in the pipeline.",
  "market_wide": {
    "risk_free_rate": {
      "cell": "B48",
      "value": 0.033919,
      "source": "ECB Data Portal, euro area AAA-rated central government bond spot rate, 10 years. Series YC.B.U2.EUR.4F.G_N_A.SV_C_YM.SR_10Y",
      "as_of": "2026-09-02",
      "note": "One rate for the entire EUR universe. The workbook settles this deliberately: country differences are carried entirely by the country risk premium at B53. Do not make this country-specific."
    },
    "mature_market_erp": {
      "cell": "B49",
      "value": 0.0423,
      "source": "Damodaran, implied equity risk premium for a mature market",
      "as_of": "2026-09-13",
      "note": "Derived as the total ERP of a zero-CRP country, which is the definition of the mature-market premium."
    },
    "long_run_nominal_growth": {
      "cell": "B50",
      "value": 0.033919,
      "source": "Set equal to B48. Damodaran's convention caps terminal growth at the risk-free rate: a company growing faster than the economy forever eventually becomes the economy, and the risk-free rate is the market's own estimate of long-run nominal growth.",
      "as_of": "2026-09-02",
      "note": "Damodaran's own convention caps terminal growth at the risk-free rate. If you adopt that, this equals B48 and moves with it."
    }
  },
